---
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-slate-200 bg-slate-900 text-slate-300">
	<div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
		<div class="grid grid-cols-1 gap-8 md:grid-cols-4">
			<!-- Col 1: Brand & Bio -->
			<div class="md:col-span-1">
				<div class="mb-4">
					<img
						src="/logotipESINSA_R-1-white.png"
						alt="ESINSA — Estanqueidad Industrial S.A."
						class="h-9 w-auto object-contain drop-shadow-[0_0_10px_rgba(59,130,246,0.35)]"
					/>
				</div>
				<p class="text-xs text-slate-400 leading-relaxed mb-4">
					Fabricación y distribución de soluciones integrales de estanqueidad, tornillería industrial y servicios avanzados de corte y plegado desde 1985.
				</p>
				<div class="flex flex-wrap gap-2 text-[11px] text-slate-400">
					<span class="rounded bg-slate-800 px-2 py-1 border border-slate-700">ISO 9000</span>
					<span class="rounded bg-slate-800 px-2 py-1 border border-slate-700">ACCIÓ Gencat</span>
				</div>
			</div>

			<!-- Col 2: Navigation Links -->
			<div>
				<h4 class="text-xs font-bold uppercase tracking-wider text-white mb-3">Navegación</h4>
				<ul class="space-y-2 text-xs">
					<li><a href="/" class="hover:text-blue-400 transition-colors">Inicio</a></li>
					<li><a href="/empresa" class="hover:text-blue-400 transition-colors">Nuestra Empresa (1985)</a></li>
					<li><a href="/productos" class="hover:text-blue-400 transition-colors">Catálogo de Productos</a></li>
					<li><a href="/servicios" class="hover:text-blue-400 transition-colors">Servicios Técnicos y Taller</a></li>
					<li><a href="/contacto" class="hover:text-blue-400 transition-colors">Contacto y Localización</a></li>
				</ul>
			</div>

			<!-- Col 3: Presentation Letters & Intranet -->
			<div>
				<h4 class="text-xs font-bold uppercase tracking-wider text-white mb-3">Documentación & SGA</h4>
				<ul class="space-y-2 text-xs">
					<li><a href="/dashboard" target="_blank" rel="noopener noreferrer" class="text-blue-400 hover:text-blue-300 font-semibold transition-colors flex items-center gap-1">
						<span>→ Panel SGA (Intranet) ↗</span>
					</a></li>
					<li><a href="/carta-presentacion-es.html" target="_blank" class="hover:text-blue-400 transition-colors">Carta Presentación (Español)</a></li>
					<li><a href="/carta-presentacion-ca.html" target="_blank" class="hover:text-blue-400 transition-colors">Carta Presentació (Català)</a></li>
				</ul>
			</div>

			<!-- Col 4: Contact details -->
			<div>
				<h4 class="text-xs font-bold uppercase tracking-wider text-white mb-3">Sede Central y Almacén</h4>
				<p class="text-xs text-slate-400 leading-relaxed">
					Polígono Industrial Riu Clar<br />
					C/. Ferro Nº 10 – 43006 Tarragona<br />
					<strong class="text-slate-300">Tel:</strong> +34 977 553072<br />
					<strong class="text-slate-300">Email:</strong> esinsa@esinsa.es<br />
					<strong class="text-slate-300">Horario:</strong> Lunes a Viernes de 8:00 a 17:00 h
				</p>
			</div>
		</div>

		<div class="mt-8 border-t border-slate-800 pt-6 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-slate-500">
			<p>© {currentYear} ESINSA (Estanqueidad Industrial S.A.). Todos los derechos reservados.</p>
			<div class="flex gap-4">
				<span>Pol. Ind. Riu Clar, Tarragona</span>
				<span>·</span>
				<span>Soluciones de Estanqueidad Industrial</span>
			</div>
		</div>
	</div>
</footer>
