---
interface Props {
	slug?: string;
	title: string;
	category: string;
	standard?: string;
	maxTemperature?: number;
	maxPressureBar?: number;
	description: string;
	applications?: string[];
	badge?: string;
}

const {
	slug,
	title,
	category,
	standard,
	maxTemperature,
	maxPressureBar,
	description,
	applications = [],
	badge,
} = Astro.props;
---

<article class="group flex flex-col rounded-xl border border-slate-200 bg-white p-6 shadow-sm transition-all hover:border-blue-400 hover:shadow-md hover:-translate-y-0.5 dark:border-slate-800 dark:bg-slate-900/80 dark:hover:border-blue-500/60 dark:hover:shadow-blue-500/5">
	<!-- Card Top: Category and Badge -->
	<div class="flex items-center justify-between mb-3">
		<span class="rounded-full bg-blue-50 px-3 py-1 text-[11px] font-bold text-blue-700 border border-blue-100 uppercase tracking-wide dark:bg-blue-950/80 dark:border-blue-800/40 dark:text-blue-400">
			{category}
		</span>
		{badge && (
			<span class="rounded-full bg-emerald-50 px-2.5 py-0.5 text-[10px] font-semibold text-emerald-700 border border-emerald-100 dark:bg-emerald-950/80 dark:border-emerald-800/40 dark:text-emerald-400">
				{badge}
			</span>
		)}
	</div>

	<!-- Product Title -->
	<h3 class="text-base font-bold text-slate-900 group-hover:text-blue-600 transition-colors mb-2 dark:text-white dark:group-hover:text-blue-400">
		{slug ? (
			<a href={`/productos/${slug}`} class="focus:outline-none">
				{title}
			</a>
		) : (
			title
		)}
	</h3>

	<!-- Description -->
	<p class="text-xs text-slate-600 leading-relaxed mb-4 flex-1 dark:text-slate-300">
		{description}
	</p>

	<!-- Technical Specs Badges -->
	{(standard || maxTemperature || maxPressureBar) && (
		<div class="mb-4 grid grid-cols-2 gap-2 border-y border-slate-100 py-3 text-[11px] dark:border-slate-800/80">
			{standard && (
				<div class="col-span-2 flex items-center justify-between text-slate-500 dark:text-slate-400">
					<span>Normativa:</span>
					<strong class="font-semibold text-slate-800 dark:text-slate-200">{standard}</strong>
				</div>
			)}
			{maxTemperature && (
				<div class="flex items-center justify-between text-slate-500 dark:text-slate-400">
					<span>Tª Máx:</span>
					<strong class="font-semibold text-slate-800 dark:text-slate-200">{maxTemperature} °C</strong>
				</div>
			)}
			{maxPressureBar && (
				<div class="flex items-center justify-between text-slate-500 dark:text-slate-400">
					<span>Presión Máx:</span>
					<strong class="font-semibold text-slate-800 dark:text-slate-200">{maxPressureBar} bar</strong>
				</div>
			)}
		</div>
	)}

	<!-- Applications Tags & Action -->
	<div class="mt-auto pt-2 flex flex-col gap-3">
		{applications.length > 0 && (
			<div>
				<span class="block text-[10px] font-bold uppercase tracking-wider text-slate-400 mb-1.5 dark:text-slate-500">Sectores:</span>
				<div class="flex flex-wrap gap-1.5">
					{applications.map((app) => (
						<span class="rounded bg-slate-100 px-2 py-0.5 text-[10px] font-medium text-slate-600 border border-slate-200 dark:bg-slate-800 dark:text-slate-300 dark:border-slate-700/50">
							{app}
						</span>
					))}
				</div>
			</div>
		)}

		{slug && (
			<a
				href={`/productos/${slug}`}
				class="text-xs font-semibold text-blue-600 hover:text-blue-700 transition-colors flex items-center gap-1 mt-1 pt-2 border-t border-slate-100 dark:text-blue-400 dark:hover:text-blue-300 dark:border-slate-800"
			>
				<span>Ver ficha técnica completa</span>
				<span>→</span>
			</a>
		)}
	</div>
</article>
