---
import PublicLayout from '../../layouts/PublicLayout.astro';
import ProductCard from '../../components/public/ProductCard.astro';
import { PRODUCTS_CATALOG } from '../../data/productsCatalog';
---

<PublicLayout title="Catálogo de Juntas de Estanqueidad y Tornillería — ESINSA">
	<!-- Hero Header (siempre oscuro) -->
	<div class="relative overflow-hidden bg-gradient-to-b from-[#0F172A] via-[#0B1120] to-[#0B1120] py-14 text-white border-b border-slate-800/80">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative z-10">
			<div class="inline-flex items-center gap-2 rounded-full border border-blue-500/20 bg-blue-500/10 px-3 py-1 text-xs font-semibold text-blue-400 mb-4 backdrop-blur-md">
				<span>Catálogo Técnico B2B</span>
				<span class="text-slate-500">·</span>
				<span>Polígono Riu Clar, Tarragona</span>
			</div>
			<h1 class="text-3xl font-black tracking-tight sm:text-5xl mt-1 text-white">
				Soluciones de Sellado y <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-cyan-300">Tornillería Industrial</span>
			</h1>
			<p class="text-sm text-slate-300 mt-3 max-w-3xl leading-relaxed">
				Más de 60.000 referencias en stock estandarizadas con códigos NUT. Seleccione cualquier referencia para consultar su ficha técnica, presiones admisibles, normativas y disponibilidad en almacén.
			</p>
		</div>

		<!-- Decorative Ambient Glows -->
		<div class="absolute -top-32 right-1/4 h-80 w-80 rounded-full bg-blue-600/10 blur-3xl pointer-events-none"></div>
		<div class="absolute -bottom-20 -right-20 h-72 w-72 rounded-full bg-cyan-500/10 blur-3xl pointer-events-none"></div>
	</div>

	<div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
		<!-- Toolbar / Mode info -->
		<div class="mb-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-slate-200 pb-5 dark:border-slate-800/80">
			<div>
				<h2 class="text-lg font-bold text-slate-900 flex items-center gap-2 dark:text-white">
					<span>Referencias Industriales</span>
					<span class="rounded-full bg-blue-100 border border-blue-200 px-2 py-0.5 text-xs text-blue-700 font-mono dark:bg-blue-950 dark:border-blue-800/50 dark:text-blue-400">
						{PRODUCTS_CATALOG.length}
					</span>
				</h2>
				<p class="text-xs text-slate-500 mt-0.5 dark:text-slate-400">Tarjetas técnicas interactivas — Haga clic en cualquier producto para abrir su especificación</p>
			</div>

			<div class="flex items-center gap-3">
				<a
					href="/dashboard"
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex items-center gap-2 rounded-lg border border-slate-300 bg-white px-3.5 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-50 transition-all group dark:border-slate-700/80 dark:bg-slate-800/60 dark:text-slate-200 dark:hover:bg-slate-700/80 dark:hover:text-white"
				>
					<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M3 3h18v18H3z"/><path d="M3 9h18"/><path d="M9 21V9"/>
					</svg>
					<span>Ver gestión en tabla (SGA)</span>
					<span class="text-blue-600 group-hover:translate-x-0.5 transition-transform dark:text-blue-400">↗</span>
				</a>
			</div>
		</div>

		<!-- Products rendered strictly as dynamic Cards -->
		<div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
			{PRODUCTS_CATALOG.map((p) => (
				<ProductCard {...p} />
			))}
		</div>
	</div>
</PublicLayout>
