---
import PublicLayout from '../layouts/PublicLayout.astro';
import ProductCard from '../components/public/ProductCard.astro';

const featuredProducts = [
	{
		slug: 'espirometalica-316l-dn50',
		title: 'Junta Espirometálica 316L DN50 PN16',
		category: 'Espirometálicas',
		standard: 'ASME B16.20 / EN 1514-2',
		maxTemperature: 550,
		maxPressureBar: 250,
		description: 'Espiras en acero inoxidable AISI 316L y relleno de grafito de alta pureza con anillos de centraje y refuerzo exterior.',
		applications: ['Petroquímica', 'Refinerías', 'Vapor a alta presión'],
		badge: 'Stock Inmediato',
	},
	{
		slug: 'grafito-flexible-armado-dn80',
		title: 'Junta de Grafito Flexible Armado DN80',
		category: 'Grafito Puro',
		standard: 'DIN 2690 / EN 1514-1',
		maxTemperature: 450,
		maxPressureBar: 120,
		description: 'Lámina de grafito mineral flexible expandido reforzado con inserto de chapa de acero inoxidable perforado.',
		applications: ['Química', 'Calderería', 'Intercambiadores'],
		badge: 'Alta Estanqueidad',
	},
	{
		slug: 'ptfe-virgen-expandido-dn80',
		title: 'Junta PTFE Virgen / Expandido DN100',
		category: 'PTFE Fluoropolímero',
		standard: 'FDA / EN 1514-1',
		maxTemperature: 260,
		maxPressureBar: 80,
		description: 'Resistencia química universal frente a ácidos, bases y fluidos altamente corrosivos en plantas industriales.',
		applications: ['Farmacéutica', 'Química Fina', 'Tratamiento Aguas'],
		badge: 'Grado Alimentario',
	},
	{
		slug: 'kammprofile-dn150-dn200',
		title: 'Junta Dentada Kammprofile DN150',
		category: 'Kammprofile',
		standard: 'DIN EN 12560-6',
		maxTemperature: 600,
		maxPressureBar: 300,
		description: 'Núcleo metálico con ranuras concéntricas mecanizadas y capas de recubrimiento en grafito o PTFE.',
		applications: ['Planta Química', 'Generación Energía', 'Vapor'],
		badge: 'Servicio Crítico',
	},
	{
		slug: 'rtj-r24-r31',
		title: 'Anillo Metálico RTJ R24 / R31',
		category: 'RTJ Metálica',
		standard: 'ASME B16.20 / API 6A',
		maxTemperature: 800,
		maxPressureBar: 400,
		description: 'Juntas macizas octogonales y ovaladas de ajuste preciso en ranura bridada para petroquímica y gas.',
		applications: ['Oil & Gas', 'Plataformas', 'Alta Presión'],
		badge: 'API 6A',
	},
	{
		slug: 'esparragos-astm-a193-b7',
		title: 'Espárrago ASTM A193 B7 + Tuerca 2H M16x100',
		category: 'Tornillería B7/2H',
		standard: 'ASTM A193 / ASTM A194',
		maxTemperature: 500,
		maxPressureBar: 250,
		description: 'Espárragos roscados con acabado cincado, galvanizado o aleaciones especiales como Inconel y Monel.',
		applications: ['Montaje de Bridas', 'Valvulería', 'Tuberías'],
		badge: 'Certificado 3.1',
	},
];

const pillars = [
	{
		title: 'Rapidez en la Entrega',
		desc: 'Servicio de entrega inmediato y programado en el Polígono Riu Clar y polos químicos de Tarragona.',
		icon: '⚡',
	},
	{
		title: 'Asesoramiento Técnico',
		desc: 'Ingeniería aplicada para industrias críticas: química, petroquímica, energía, gas, petróleo y naval.',
		icon: '🛠️',
	},
	{
		title: 'Productos a Medida',
		desc: 'Fabricación ágil de juntas planas estándares y a medida mediante corte por chorro de agua y plotter CNC.',
		icon: '📐',
	},
	{
		title: 'Quality Service y Montaje',
		desc: 'Cálculo de pares de apriete, selección de juntas y verificación de uniones bridadas para eliminar fugas.',
		icon: '🔍',
	},
];

const clients = [
	'REPSOL',
	'DOW CHEMICAL',
	'BASF',
	'CEPSA',
	'ERCROS',
	'MASA',
	'CLARIANT',
	'PETROTARRACO',
];
---

<PublicLayout title="ESINSA — Soluciones de Estanqueidad Industrial y Tornillería (Tarragona)">
	<!-- Hero Section (siempre oscuro por diseño) -->
	<section class="relative overflow-hidden bg-gradient-to-b from-[#0F172A] via-[#0B1120] to-[#0B1120] py-20 sm:py-28 border-b border-slate-800">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative z-10">
			<div class="max-w-3xl">
				<div class="inline-flex items-center gap-2 rounded-full border border-blue-500/30 bg-blue-500/10 px-3.5 py-1 text-xs font-semibold text-blue-400 mb-6 backdrop-blur">
					<span class="flex h-2 w-2 rounded-full bg-blue-400 animate-pulse"></span>
					<span>Desde 1985 · 40 Años de Excelencia en Estanqueidad</span>
				</div>

				<h1 class="text-3xl font-black tracking-tight sm:text-5xl lg:text-6xl text-white leading-tight mb-6">
					Sellado eficiente y seguro para la <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-cyan-400 to-teal-300">industria</span>
				</h1>

				<p class="text-base text-slate-300 leading-relaxed mb-8 max-w-2xl sm:text-lg">
					En <strong>ESINSA</strong> fabricamos juntas planas de estanqueidad y distribuimos juntas espirometálicas, tornillería industrial y servicios avanzados de corte y plegado desde nuestras instalaciones en el Polígono Industrial Riu Clar de Tarragona.
				</p>

				<div class="flex flex-wrap items-center gap-4">
					<a
						href="/productos"
						class="rounded-lg bg-blue-600 px-6 py-3 text-sm font-bold text-white shadow-lg hover:bg-blue-500 transition-all hover:shadow-blue-500/25"
					>
						Explorar Catálogo de Juntas
					</a>
					<a
						href="/dashboard"
						target="_blank"
						rel="noopener noreferrer"
						class="rounded-lg border border-slate-700 bg-slate-800/90 px-6 py-3 text-sm font-semibold text-slate-200 hover:bg-slate-700 hover:text-white transition-all flex items-center gap-2 group"
					>
						<span>Acceso Panel SGA</span>
						<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-blue-400 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform">
							<path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
						</svg>
					</a>
				</div>
			</div>
		</div>

		<!-- Background Glow Decoration -->
		<div class="absolute -top-40 -right-40 h-96 w-96 rounded-full bg-blue-600/15 blur-3xl pointer-events-none"></div>
	</section>

	<!-- 4 Pillars Section -->
	<section class="py-16 bg-white border-b border-slate-200 dark:bg-[#0B1120] dark:border-slate-800">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<div class="text-center max-w-2xl mx-auto mb-12">
				<h2 class="text-xs font-bold uppercase tracking-wider text-blue-600 mb-2 dark:text-blue-400">Compromiso Operativo</h2>
				<p class="text-2xl font-black text-slate-900 sm:text-3xl dark:text-white">ESINSA te ofrece</p>
			</div>

			<div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
				{pillars.map((p) => (
					<div class="rounded-xl border border-slate-200 bg-slate-50 p-6 transition-all hover:bg-white hover:border-blue-300 hover:shadow-lg dark:border-slate-800 dark:bg-slate-900/60 dark:hover:bg-slate-800/80 dark:hover:border-slate-700">
						<div class="text-3xl mb-4">{p.icon}</div>
						<h3 class="text-base font-bold text-slate-900 mb-2 dark:text-white">{p.title}</h3>
						<p class="text-xs text-slate-600 leading-relaxed dark:text-slate-400">{p.desc}</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- Featured Products rendered as Cards -->
	<section class="py-16 bg-slate-50 border-b border-slate-200 dark:bg-[#070D19] dark:border-slate-800">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<div class="flex flex-col md:flex-row md:items-end md:justify-between mb-12 gap-4">
				<div>
					<h2 class="text-xs font-bold uppercase tracking-wider text-blue-600 mb-2 dark:text-blue-400">Soluciones de Estanqueidad</h2>
					<p class="text-2xl font-black text-slate-900 sm:text-3xl dark:text-white">Productos Destacados</p>
				</div>
				<a
					href="/productos"
					class="text-sm font-bold text-blue-600 hover:text-blue-700 transition-colors flex items-center gap-1 dark:text-blue-400 dark:hover:text-blue-300"
				>
					<span>Ver las 60.000 referencias en catálogo</span>
					<span>→</span>
				</a>
			</div>

			<!-- Cards Grid -->
			<div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
				{featuredProducts.map((prod) => (
					<ProductCard {...prod} />
				))}
			</div>
		</div>
	</section>

	<!-- Industrial Clients Bar -->
	<section class="py-12 bg-white dark:bg-[#0B1120]">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<p class="text-center text-xs font-bold uppercase tracking-wider text-slate-400 mb-8 dark:text-slate-500">
				Más de 1.600 clientes industriales confían en nuestras uniones bridadas
			</p>
			<div class="flex flex-wrap items-center justify-center gap-8 md:gap-14 opacity-80">
				{clients.map((c) => (
					<span class="text-sm font-extrabold tracking-wider text-slate-500 hover:text-blue-600 transition-colors dark:text-slate-400 dark:hover:text-blue-400">
						{c}
					</span>
				))}
			</div>
		</div>
	</section>
</PublicLayout>
