# =============================================================================
# ESINSA SGA — Warehouse Management System
# Polígono Industrial Ri Clar, Tarragona
# =============================================================================

# -----------------------------------------------------------------------------
# INSFORGE BACKEND (PostgreSQL + Auth + Realtime + Storage)
# Get values from: npx -y @insforge/cli secrets get <KEY>
# Project: astro-awesome-projects (https://5xz8euqt.ap-southeast.insforge.app)
# -----------------------------------------------------------------------------
PUBLIC_INSFORGE_URL=https://5xz8euqt.ap-southeast.insforge.app
PUBLIC_INSFORGE_ANON_KEY=
INSFORGE_API_KEY=

# Prisma uses the same Postgres connection (InsForge managed)
# Format: postgresql://user:pass@host:port/db?schema=public
DATABASE_URL=

# -----------------------------------------------------------------------------
# CORS & SECURITY
# -----------------------------------------------------------------------------
# Comma-separated allowed origins for CORS (e.g., https://whm.esinsa.com,http://localhost:4321)
CORS_ORIGIN=http://localhost:4321

# -----------------------------------------------------------------------------
# AI ASSISTANT (OpenAI-compatible)
# -----------------------------------------------------------------------------
# Strategy:
# - Development: OpenRouter (flexible & free/low-cost models)
# - Production: DeepSeek Platform (high-performance & low-latency with client funds)
#
# Option A: OpenRouter (Development preset)
PUBLIC_AI_ENDPOINT=https://openrouter.ai/api/v1
PUBLIC_AI_KEY=
PUBLIC_AI_MODEL=deepseek/deepseek-chat
# Other free dev options: google/gemini-2.0-flash-exp:free, meta-llama/llama-3.3-70b-instruct:free
#
# Option B: DeepSeek Platform (Production preset)
# PUBLIC_AI_ENDPOINT=https://api.deepseek.com
# PUBLIC_AI_KEY=sk-...
# PUBLIC_AI_MODEL=deepseek-chat

# -----------------------------------------------------------------------------
# AUTHENTICATION
# -----------------------------------------------------------------------------
# Comma-separated OAuth providers to show on login (google, github, gitlab)
PUBLIC_AUTH_OAUTH_PROVIDERS=google,github

# Keystatic CMS Admin Authentication
# Generate with: openssl rand -base64 32
KEYSTATIC_AUTH_SECRET=

# Optional: GitHub OAuth for Keystatic (if not using InsForge OAuth)
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# MESSAGING BACKEND (server/)
# -----------------------------------------------------------------------------
# Telegram Bot (get from @BotFather)
TELEGRAM_BOT_TOKEN=

# WhatsApp Cloud API (Meta Business)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_SECRET=

# Server binding
SERVER_PORT=8787
SERVER_HOST=0.0.0.0

# -----------------------------------------------------------------------------
# KEYSTATIC CMS CONTENT
# -----------------------------------------------------------------------------
# Keystatic reads content from GitHub / local filesystem
# For GitHub mode (production):
KEYSTATIC_GITHUB_REPO=owner/repo
KEYSTATIC_GITHUB_BRANCH=main
KEYSTATIC_GITHUB_TOKEN=

# For local development (file-based):
# KEYSTATIC_STORAGE_PATH=./keystatic-content

# -----------------------------------------------------------------------------
# DEVELOPMENT / DEBUG
# -----------------------------------------------------------------------------
# Log level: debug, info, warn, error
LOG_LEVEL=info

# Enable Prisma query logging
PRISMA_LOG_QUERIES=false

# Mock data injection (development only)
ENABLE_MOCK_DATA=true

# -----------------------------------------------------------------------------
# FEATURE FLAGS
# -----------------------------------------------------------------------------
ENABLE_VOICE_PICKING=true
ENABLE_AI_ASSISTANT=true
ENABLE_KEYSTATIC_CMS=true
ENABLE_EDI_INTEGRATION=false
